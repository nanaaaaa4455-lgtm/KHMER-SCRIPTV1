-- Hàm tìm trứng trong bán kính
local function FindNearestEgg()
    local nearest = nil
    local minDist = Config.RadiusSteal
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not HRP then return nil end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
            local dist = (obj.Position - HRP.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = obj
            end
        end
    end
    
    return nearest
end

-- Hàm tween đến vị trí
local function TweenToPosition(targetCFrame, speed)
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    
    local distance = (targetCFrame.Position - HRP.Position).Magnitude
    local duration = distance / (speed or 100)
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(HRP, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Vòng lặp chính
local function MainLoop()
    while GUI and GUI.Parent do
        -- Logic Auto Steal
        if Config.AutoSteal then
            local egg = FindNearestEgg()
            if egg then
                TweenToPosition(egg.CFrame + Vector3.new(0, 3, 0), 200)
                task.wait(0.5)
            end
        end
        
        -- Logic Auto Place (cần điều chỉnh theo game)
        if Config.AutoPlace then
            -- Tìm vị trí đặt trứng (thường là ở base)
            -- Code phụ thuộc vào cấu trúc game
        end
        
        -- Logic Auto Hatch
        if Config.AutoHatch then
            -- Kích hoạt ấp trứng
            -- Code phụ thuộc vào game
        end
        
        -- Logic NoClip
        if Config.NoClip and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
        
        -- Logic Anti Ragdoll
        if Config.AntiRagdoll and LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end
        end
        
        RunService.Heartbeat:Wait()
    end
end

